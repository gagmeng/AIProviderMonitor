{
  "name": "ai-provider-monitor",
  "productName": "AI Provider Monitor",
  "version": "1.2.0",
  "description": "AI Provider 状态与可用模型监控",
  "main": "main.js",
  "author": "AIProviderMonitor",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/smoke.js",
    "smoke": "electron . --smoke-test",
    "app-test": "electron . --smoke-test",
    "renderer-test": "electron tests/renderer-check.js",
    "ui-check": "electron tests/ui-check.js",
    "gen-icons": "node scripts/gen-icons.js",
    "lint": "eslint main.js preload.js src renderer scripts tests",
    "lint:fix": "eslint --fix main.js preload.js src renderer scripts tests",
    "format": "prettier --write \"**/*.{js,json,css,html}\"",
    "dist": "electron-builder --win nsis portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3"
  },
  "build": {
    "appId": "com.aiprovider.monitor",
    "productName": "AI Provider Monitor",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "AIProviderMonitor-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Provider Monitor"
    },
    "portable": {
      "artifactName": "AIProviderMonitor-Portable-${version}.${ext}"
    }
  }
}